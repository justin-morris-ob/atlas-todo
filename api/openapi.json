{
  "openapi": "3.1.0",
  "info": {
    "title": "Hello Todo read API",
    "version": "1.0.0",
    "description": "POC backend-to-backend API. Credential selects one demo owner. Not production identity or tenant authorization."
  },
  "servers": [
    {
      "url": "http://localhost:4711"
    }
  ],
  "security": [
    {
      "bcReadToken": []
    }
  ],
  "paths": {
    "/api/v1/todos": {
      "get": {
        "operationId": "listTodos",
        "summary": "Read the credential-bound todo list",
        "responses": {
          "200": {
            "description": "Up to 100 todos in creation order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoList"
                }
              }
            }
          },
          "400": {
            "description": "Query parameters are not supported"
          },
          "401": {
            "description": "Missing or invalid credential"
          },
          "403": {
            "description": "A service credential is required"
          },
          "500": {
            "description": "Service or database unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bcReadToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Todo": {
        "type": "object",
        "required": [
          "id",
          "title",
          "completed"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "completed": {
            "type": "boolean"
          }
        }
      },
      "TodoList": {
        "type": "object",
        "required": [
          "ownerId",
          "todos"
        ],
        "additionalProperties": false,
        "properties": {
          "ownerId": {
            "type": "string"
          },
          "todos": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "completed"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f-]{36}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "completed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
